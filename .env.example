# Optional for automation/testing. End users can configure password in-app.
# Do not commit real secrets.
TRANSCRIBENOTES_DB_KEY=replace-with-a-strong-passphrase
# Optional. Defaults to ./data/transcribenotes.db if omitted.
TRANSCRIBENOTES_DB_PATH=data/transcribenotes.db
# Optional. Override where remembered DB password is stored.
TRANSCRIBENOTES_KEY_FILE=.transcribenotes/db_key.bin

HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING = true

INPUT_DEFAULT_LANGUAGE = None
CACHED_MODEL_DIR = cached_models/
HF_DATASETS_CACHE = hf_datasets_cache/